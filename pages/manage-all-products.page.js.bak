const PAGE_SIZE = 50;

function getSupabaseClient() {
  let url = window.SUPABASE_URL;
  let key = window.SUPABASE_ANON_KEY;
  
  // Try to get from admin auth if available
  if ((!url || !key) && window.adminAuth) {
    const backend = window.adminAuth.getActiveBackend ? window.adminAuth.getActiveBackend() : null;
    if (backend) {
      url = backend.url;
      key = backend.key;
    }
  }
  
  url = url || "https://msgqzgzoslearaprgiqq.supabase.co";
  key = key || "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1zZ3F6Z3pvc2xlYXJhcHJnaXFxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzAzMzk3MTIsImV4cCI6MjA4NTkxNTcxMn0.fQu1toCisGIly8FZqHy3yoEwnY-e7vthk8PCmkBMifE";
  return window.supabase.createClient(url, key);
}

let allProducts = [];
let currentPage = 0;
let filteredProducts = [];

function escapeHtml(value) {
  return String(value ?? "")
    .replaceAll("&", "&")
    .replaceAll("<", "<")
    .replaceAll(">", ">")
    .replaceAll('"', '"');
}

function toNumber(value) {
  const n = Number(value);
  return Number.isFinite(n) ? n : 0;
}

function isVendorProduct(product) {
  const name = (product.product_name || product.name || "").toLowerCase();
  return name.startsWith("vendor_");
}

function buildRow(p) {
  const img = escapeHtml(p.image || p.img1 || p.image1 || p.image_link1 || "");
  const name = escapeHtml(p.product_name || p.name || "-");
  const id = escapeHtml(p.id || "");
  const price = toNumber(p.price).toFixed(2);
  const discountPct = toNumber(p.discount_percent);
  const priceAfterDiscount = discountPct > 0 
    ? (toNumber(p.price) - (toNumber(p.price) * discountPct) / 100).toFixed(2)
    : (toNumber(p.price_after_discount) || toNumber(p.final_price) || toNumber(p.sale_price) || price);
  const stock = toNumber(p.quantity || p.stock);
  const category = escapeHtml(p.category || p.store_category || "-");
  const isActive = p.is_active !== false && p.status !== "inactive";
  const statusText = isActive ? "نشط" : "غير نشط";
  const statusClass = isActive ? "stat-active" : "stat-inactive";
  const soldCount = toNumber(p.sold_count || p.sales_count || p.total_sold || 0);

  return `
  <tr data-id="${escapeHtml(p.id)}">
    <td>
      <img src="${img}" alt="${name}" loading="lazy" 
        onerror="this.src='data:image/svg+xml;utf8,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Crect width=%27100%27 height=%27100%27 fill=%27%23f3f4f6%27/%3E%3Ctext x=%2750%27 y=%2755%27 text-anchor=%27middle%27 fill=%27%2394a3b8%27 font-size=%2730%27%3E📦%3C/text%3E%3C/svg%3E'" />
    </td>
    <td class="product-name-cell">
      <strong>${name}</strong>
      <small>ID: ${id}</small>
    </td>
    <td>${price} ج.م</td>
    <td>${priceAfterDiscount} ج.م</td>
    <td>${stock}</td>
    <td>${category}</td>
    <td><span class="stat-badge ${statusClass}">${statusText}</span></td>
    <td>${soldCount}</td>
    <td>
      <a class="edit-btn" href="manage-product-edit.html?id=${encodeURIComponent(p.id)}">
        <i class="fa-solid fa-pen-to-square"></i> تعديل
      </a>
    </td>
  </tr>`;
}

function renderProducts() {
  const body = document.getElementById("productsBody");
  const countEl = document.getElementById("productsCount");
  const total = filteredProducts.length;
  
  if (countEl) countEl.textContent = `إجمالي: ${total} منتج`;

  const start = currentPage * PAGE_SIZE;
  const end = start + PAGE_SIZE;
  const visible = filteredProducts.slice(start, end);

  if (!visible.length) {
    body.innerHTML = '<tr><td colspan="9" class="empty-state">لا توجد منتجات مطابقة</td></tr>';
  } else {
    body.innerHTML = visible.map(buildRow).join("");
  }

  const totalPages = Math.ceil(total / PAGE_SIZE) || 1;
  const prevBtn = document.getElementById("prevBtn");
  const nextBtn = document.getElementById("nextBtn");
  const pageInfo = document.getElementById("pageInfo");

  if (prevBtn) prevBtn.disabled = currentPage === 0;
  if (nextBtn) nextBtn.disabled = currentPage >= totalPages - 1;
  if (pageInfo) pageInfo.textContent = `صفحة ${currentPage + 1} من ${totalPages}`;
}

function applyFilters() {
  const query = document.getElementById("searchInput")?.value.trim().toLowerCase() || "";
  
  if (!query) {
    filteredProducts = [...allProducts];
  } else {
    filteredProducts = allProducts.filter(p =>
      (p.product_name || "").toLowerCase().includes(query) ||
      (p.name || "").toLowerCase().includes(query) ||
      (p.id || "").toString().includes(query) ||
      (p.category || "").toLowerCase().includes(query) ||
      (p.sku || "").toLowerCase().includes(query)
    );
  }
  
  currentPage = 0;
  renderProducts();
}

function changePage(delta) {
  const totalPages = Math.ceil(filteredProducts.length / PAGE_SIZE) || 1;
  const newPage = currentPage + delta;
  if (newPage >= 0 && newPage < totalPages) {
    currentPage = newPage;
    renderProducts();
  }
}

async function testBackend(backend) {
  try {
    const client = window.supabase.createClient(backend.url, backend.key);
    const { data, error } = await client
      .from("products")
      .select("id")
      .limit(1);
    if (error) return { ok: false, error };
    return { ok: true, count: data?.length || 0 };
  } catch (e) {
    return { ok: false, error: e };
  }
}

async function findBestBackend() {
  const backends = window.adminAuth?.ADMIN_BACKENDS;
  if (!backends) return null;
  for (const name of ["primary", "backup", "backup2"]) {
    const res = await testBackend(backends[name]);
    if (res.ok) {
      console.log(`Backend ${name} is healthy`);
      return backends[name];
    }
  }
  return null;
}

async function loadProducts() {
  const body = document.getElementById("productsBody");
  body.innerHTML = '<tr><td colspan="9" class="empty-state">جاري تحميل المنتجات...</td></tr>';

  // Try to find best backend first
  const best = await findBestBackend();
  if (best) {
    window.SUPABASE_URL = best.url;
    window.SUPABASE_ANON_KEY = best.key;
    window.__bodaAdminBackendName = best.name;
    console.log("Using backend:", best.name);
  }

  let totalCount = 0;
  let all = [];
  
  try {
    const client = getSupabaseClient();
    const { count, error: countError } = await client
      .from("products")
      .select("*", { count: "exact", head: true });

    if (countError) {
      console.error("Count error:", countError);
      // Try without head if count fails - get actual count by fetching small sample differently
      const { data: allIds, error: countErr2 } = await client
        .from("products")
        .select("id");
      if (!countErr2 && allIds) {
        totalCount = allIds.length;
      } else if (count) {
        totalCount = count;
      }
    } else {
      totalCount = count || 0;
    }
  } catch (e) {
    console.error("Count exception:", e);
  }
  
  console.log("Total products in table:", totalCount);

  if (totalCount > 0) {
    const batchSize = 1000;
    const batches = Math.ceil(totalCount / batchSize);
    for (let i = 0; i < batches; i++) {
      const from = i * batchSize;
      const to = from + batchSize - 1;
      try {
        const { data, error } = await getSupabaseClient()
          .from("products")
          .select("*")
          .order("updated_at", { ascending: false })
          .range(from, to);
        if (error) {
          console.error(`Batch ${i} error:`, error);
          break;
        }
        if (data && data.length > 0) {
          all = all.concat(data);
        }
        if (data && data.length < batchSize) break;
      } catch (e) {
        console.error(`Batch ${i} exception:`, e);
        break;
      }
    }
  } else {
    // Try to fetch all without count - progressive
    for (let i = 0; i < 50; i++) { // max 50k
      const from = i * 1000;
      const to = from + 999;
      try {
        const { data, error } = await getSupabaseClient()
          .from("products")
          .select("*")
          .order("updated_at", { ascending: false })
          .range(from, to);
        if (error) break;
        if (!data || data.length === 0) break;
        all = all.concat(data);
        if (data.length < 1000) break;
      } catch (e) {
        break;
      }
    }
  }

  console.log("All products fetched:", all.length);
  if (all.length > 0) {
    console.log("Sample product names:", all.slice(0, 5).map(p => p.product_name || p.name));
    console.log("Sample product IDs:", all.slice(0, 5).map(p => p.id));
    totalCount = Math.max(totalCount, all.length);
  }

  // Filter out vendor products
  const vendorProducts = all.filter(p => isVendorProduct(p));
  console.log("Vendor products filtered out:", vendorProducts.length);
  allProducts = all.filter(p => !isVendorProduct(p));
  console.log("Non-vendor products:", allProducts.length);
  
  filteredProducts = [...allProducts];
  currentPage = 0;
  renderProducts();

  // Show debug info on page
  const debugDiv = document.getElementById("debugInfo");
  const activeBackend = window.__bodaAdminBackendName || (window.adminAuth && window.adminAuth.getActiveBackend ? window.adminAuth.getActiveBackend().name : 'primary');
  if (debugDiv) {
    debugDiv.innerHTML = `
      <div style="padding:10px;background:#f0f0f0;margin:10px 0;border-radius:4px;font-size:12px;font-family:monospace;direction:ltr;text-align:left">
        <strong>Debug Info:</strong><br>
        Active Backend: ${activeBackend}<br>
        Total in table (count): ${totalCount}<br>
        Fetched: ${all.length}<br>
        Vendor (filtered): ${vendorProducts.length}<br>
        Non-vendor (shown): ${allProducts.length}<br>
        Sample names: ${all.slice(0,3).map(p => (p.product_name || p.name || 'NO NAME')).join(', ')}
      </div>
    `;
  }
}

document.addEventListener("DOMContentLoaded", () => {
  const searchInput = document.getElementById("searchInput");
  if (searchInput) searchInput.addEventListener("input", applyFilters);

  loadProducts();
});