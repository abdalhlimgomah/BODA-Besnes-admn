  document.getElementById('modalTitle').textContent = 'ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¹ط¢آ¾ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ¹ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ¯ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ·ط¢آ¥ط·آ¢ط¢آ ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط£آ¢أ¢â€ڑآ¬ط¹â€  ' + (TABLE_TITLES[table] || table);
