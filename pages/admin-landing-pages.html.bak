async function loadRefData(table, fields, existingData) {
  var refPromises = [];
  fields.forEach(function(f) {
    if (f.type === 'select' && f.refTable) {
      refPromises.push((async function() {
        try {
          var client = getClient();
          var { data } = await client.from(f.refTable).select(f.refValue + ',' + f.refLabel).order(f.refLabel);
          return { fieldId: f.id, data: data || [] };
        } catch(e) { return { fieldId: f.id, data: [] }; }
      })());
    }
  });
  var refResults = await Promise.all(refPromises);
  var refMap = {};
  refResults.forEach(function(r) { refMap[r.fieldId] = r.data; });
  return refMap;
}

function buildFormHtml(fields, data, refMap) {
  var html = '<div class="form-grid">';
  fields.forEach(function(f) {
    var val = data ? (data[f.id] !== undefined && data[f.id] !== null ? data[f.id] : '') : (f.value !== undefined ? f.value : '');
    var checked = data ? (data[f.id] !== false) : (f.checked !== false);
    var required = f.required ? ' required' : '';
    var ph = f.placeholder ? ' placeholder="' + escapeHtml(f.placeholder) + '"' : '';
    var cls = f.full ? ' class="full"' : '';

    if (f.type === 'toggle') {
      html += '<div' + cls + '><label>' + f.label + '</label><label class="toggle"><input id="f_' + f.id + '" type="checkbox"' + (checked ? ' checked' : '') + ' /><span class="toggle-slider"></span></label></div>';
    } else if (f.type === 'textarea') {
      html += '<div class="full"><label>' + f.label + '</label><textarea id="f_' + f.id + '" rows="3"' + required + '>' + escapeHtml(val) + '</textarea></div>';
    } else if (f.type === 'select') {
      var options = refMap && refMap[f.id] ? refMap[f.id] : [];
      var optsHtml = '';
      if (!f.required) optsHtml += '<option value="">-- ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ§ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ®ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¹ط¢آ¾ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ± --</option>';
      options.forEach(function(o) {
        var ov = o[f.refValue]; var ol = o[f.refLabel];
        var sel = String(ov) === String(val) ? ' selected' : '';
        optsHtml += '<option value="' + escapeHtml(ov) + '"' + sel + '>' + escapeHtml(ol) + '</option>';
      });
      html += '<div' + cls + '><label>' + f.label + '</label><select id="f_' + f.id + '"' + required + '>' + optsHtml + '</select></div>';
    } else if (f.type === 'color') {
      html += '<div' + cls + '><label>' + f.label + '</label><input id="f_' + f.id + '" type="color" value="' + (val || '#000000') + '" /></div>';
    } else if (f.type === 'image') {
      html += '<div class="full"><label>' + f.label + '</label><input id="f_' + f.id + '" type="text" value="' + escapeHtml(val) + '" placeholder="https://..."' + required + ph + ' />';
      if (val) html += '<img src="' + escapeHtml(val) + '" class="img-preview" style="margin-top:6px;" onerror="this.style.display=\'none\'" />';
      html += '</div>';
    } else {
      html += '<div' + cls + '><label>' + f.label + '</label><input id="f_' + f.id + '" type="' + f.type + '" value="' + escapeHtml(val) + '"' + required + ph + ' /></div>';
    }
  });
  html += '</div>';
  return html;
}

