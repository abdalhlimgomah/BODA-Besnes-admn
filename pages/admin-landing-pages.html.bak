    return;
  }
  container.innerHTML = data.map(function(s) {
    var activeLabel = s.is_active ? 'ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط·آ¢ط¢آ ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ´ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ·' : 'ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ·أ¢â‚¬ط›ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ·ط¢آ¥ط·آ¢ط¢آ ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ± ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط·آ¢ط¢آ ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ´ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ·';
    var activeBadge = s.is_active ? 'badge-active' : 'badge-inactive';
