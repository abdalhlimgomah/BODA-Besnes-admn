async function saveItem(e) {
  e.preventDefault();
  var client = getClient();
  if (!client) return;
  var table = currentTable;
  var fields = TABLE_FORMS[table];
  if (!fields) { alert('ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ®ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ£: ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ§ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط£آ¢أ¢â€ڑآ¬ط¹â€ ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ¬ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ¯ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ·ط¢آ«ط£آ¢أ¢â€ڑآ¬ط¢آ ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط£آ¢أ¢â€ڑآ¬ط¹â€  ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ·أ¢â‚¬ط›ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ·ط¢آ¥ط·آ¢ط¢آ ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ± ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط·آ¢ط¢آ¦ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ¹ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ±ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ·ط¢آ«ط£آ¢أ¢â€ڑآ¬ط¢آ ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ·ط¢آ¢ط·آ¸ط¢آ¾'); return; }
  var payload = {};
  fields.forEach(function(f) {
    var el = document.getElementById('f_' + f.id);
    if (!el) return;
    if (f.type === 'toggle') {
      payload[f.id] = el.checked;
    } else if (f.type === 'number') {
      payload[f.id] = parseFloat(el.value) || 0;
    } else {
      payload[f.id] = el.value.trim();
    }
  });
  if (editingId) {
    var { error } = await client.from(table).update(payload).eq('id', editingId);
    if (error) { alert('ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ®ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ£ ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ·ط¢آ¢ط·آ¸ط¢آ¾ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ·ط¢آ¥ط·آ¢ط¢آ  ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ§ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط£آ¢أ¢â€ڑآ¬ط¹â€ ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¹ط¢آ¾ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ­ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ¯ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ·ط¢آ¥ط·آ¢ط¢آ ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ«: ' + error.message); return; }
  } else {
    var { error } = await client.from(table).insert(payload);
    if (error) { alert('ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ®ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ£ ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ·ط¢آ¢ط·آ¸ط¢آ¾ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ·ط¢آ¥ط·آ¢ط¢آ  ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ§ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط£آ¢أ¢â€ڑآ¬ط¹â€ ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ¥ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ¶ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ§ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ·ط¢آ¢ط·آ¸ط¢آ¾ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ©: ' + error.message); return; }
  }
  closeModal('dataModal');
  await loadTable(table);
}

async function deleteItem(table, id) {
  if (!confirm('ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط·آ·ط¥â€™ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط£آ¢أ¢â€ڑآ¬ط¹â€  ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ£ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط·آ¢ط¢آ ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¹ط¢آ¾ ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط·آ¢ط¢آ¦ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¹ط¢آ¾ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ£ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ·ط¢آ¦ط£آ¢أ¢â€ڑآ¬أ¢â€‍آ¢ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ¯ ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط·آ¢ط¢آ¦ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط·آ¢ط¢آ  ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ­ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ°ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ·ط¢آ¢ط·آ¸ط¢آ¾ ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط·آ·ط¥â€™ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ°ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ§ ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ§ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط£آ¢أ¢â€ڑآ¬ط¹â€ ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ¹ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط·آ¢ط¢آ ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آµط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ±ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¥ط·آ¢ط¢آ¸')) return;
  var client = getClient();
  if (!client) return;
  var { error } = await client.from(table).delete().eq('id', id);
  if (error) { alert('ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ®ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ£ ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ·ط¢آ¢ط·آ¸ط¢آ¾ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ·ط¢آ¥ط·آ¢ط¢آ  ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ§ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط£آ¢أ¢â€ڑآ¬ط¹â€ ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ­ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ°ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ·ط¢آ¢ط·آ¸ط¢آ¾: ' + error.message); return; }
  await loadTable(table);
}

function loadTable(table) {
  switch (table) {
    case 'categories': return loadCategories();
    case 'category_banners': return loadCategoryBanners();
    case 'brands': return loadBrands();
    case 'brand_banners': return loadBrandBanners();
    case 'smart_category_showcase': return loadSmartShowcase();
    case 'promotional_banners': return loadPromotionalBanners();
    case 'category_brands': return loadCategoryBrands();
    case 'category_sections': return loadCategorySections();
    case 'brand_sections': return loadBrandSections();
    case 'featured_collections': return loadFeaturedCollections();
    case 'category_section_products': return loadCategorySectionProducts();
    case 'brand_section_products': return loadBrandSectionProducts();
  }
}

function previewImage(url, containerId) {
  var container = document.getElementById(containerId);
  if (!container) return;
  if (url && url.trim()) {
    container.innerHTML = '<img src="' + escapeHtml(url.trim()) + '" class="img-preview" style="margin-top:6px;" onerror="this.style.display=\'none\'" />';
  } else {
    container.innerHTML = '';
  }
}

// ==================== CATEGORIES ====================
async function loadCategories() {
  var client = getClient();
  if (!client) return;
  var { data, error } = await client.from('categories').select('*').order('sort_order', { ascending: true });
