  var html = '<div class="form-grid">';
  fields.forEach(function(f) {
    var val = data ? (data[f.id] !== undefined && data[f.id] !== null ? data[f.id] : '') : (f.value !== undefined ? f.value : '');
    var checked = data ? (data[f.id] !== false) : (f.checked !== false);
    var required = f.required ? ' required' : '';
    var ph = f.placeholder ? ' placeholder="' + escapeHtml(f.placeholder) + '"' : '';
    var cls = f.full ? ' class="full"' : '';

    if (f.type === 'toggle') {
      html += '<div' + cls + '><label>' + f.label + '</label><label class="toggle"><input id="f_' + f.id + '" type="checkbox"' + (checked ? ' checked' : '') + ' /><span class="toggle-slider"></span></label></div>';
    } else if (f.type === 'textarea') {
      html += '<div class="full"><label>' + f.label + '</label><textarea id="f_' + f.id + '" rows="3"' + required + '>' + escapeHtml(val) + '</textarea></div>';
    } else if (f.type === 'select') {
      html += '<div' + cls + '><label>' + f.label + '</label><select id="f_' + f.id + '"' + required + '></select></div>';
    } else if (f.type === 'color') {
      html += '<div' + cls + '><label>' + f.label + '</label><input id="f_' + f.id + '" type="color" value="' + (val || '#000000') + '" /></div>';
    } else if (f.type === 'image') {
      html += '<div class="full"><label>' + f.label + '</label><input id="f_' + f.id + '" type="text" value="' + escapeHtml(val) + '" placeholder="https://..."' + required + ph + ' oninput="previewImage(this.value,\'prev_' + f.id + '\')" />';
      html += '<div id="prev_' + f.id + '">';
      if (val) html += '<img src="' + escapeHtml(val) + '" class="img-preview" style="margin-top:6px;" onerror="this.style.display=\'none\'" />';
      html += '</div></div>';
    } else {
      html += '<div' + cls + '><label>' + f.label + '</label><input id="f_' + f.id + '" type="' + f.type + '" value="' + escapeHtml(val) + '"' + required + ph + ' /></div>';
    }
  });
  html += '</div>';
  return html;
}

async function populateSelects(table, data) {
  var fields = TABLE_FORMS[table] || [];
  var promises = [];
  fields.forEach(function(f) {
    if (f.type === 'select' && f.refTable) {
      promises.push((async function() {
        try {
          var client = getClient();
          try { var { data: refData } = await client.from(f.refTable).select(f.refValue + ',' + f.refLabel).order(f.refLabel, { ascending: true }); } catch(e) { refData = []; }
          var sel = document.getElementById('f_' + f.id);
          if (!sel) return;
          if (!f.required) { var opt = document.createElement('option'); opt.value = ''; opt.textContent = '-- ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ§ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ®ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¹ط¢آ¾ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ± --'; sel.appendChild(opt); }
          if (refData) refData.forEach(function(o) {
            var opt = document.createElement('option');
            opt.value = o[f.refValue];
            opt.textContent = o[f.refLabel];
            if (data && String(o[f.refValue]) === String(data[f.id])) opt.selected = true;
            sel.appendChild(opt);
          });
        } catch(e) { console.warn('Error loading ref data for ' + f.id, e); }
      })());
    }
  });
  await Promise.all(promises);
}

async function openAddModal(table) {
  currentTable = table;
  editingId = null;
  document.getElementById('modalTitle').textContent = 'ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ¥ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ¶ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ§ط·آ·ط¢آ£ط£آ¢أ¢â‚¬â€چط¢آ¢ط·آ·ط¢آ¢ط·آ¸ط¢آ¾ط·آ·ط¢آ£ط·آ¹ط¢آ©ط·آ·ط¢آ¢ط·آ¢ط¢آ© ' + (TABLE_TITLES[table] || table);
  var fields = TABLE_FORMS[table];
  var html = buildFormHtmlForItem(table, null);
  document.getElementById('modalFormContent').innerHTML = html;
  document.getElementById('modalPreviewArea').style.display = 'none';
  await populateSelects(table, null);
  openModal('dataModal');
}

